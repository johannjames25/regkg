   "conflict": false,
   "id": "KN-22"
  },
  {
   "layer": "bridge",
   "type": "KnowledgeNeed",
   "knowledge_type": "COVERAGE",
   "level": "P3",
   "text": "Deadline basis conflicts.",
   "conflict": false,
   "id": "KN-23"
  },
  {
   "layer": "bridge",
   "type": "KnowledgeNeed",
   "knowledge_type": "COVERAGE",
